# Copie para `.env` (ignorado pelo git) e preencha. Nunca commite o `.env`.
# Guia completo: docs/setup-ambiente.md

# --- Frontend (valores públicos; vão para o bundle do navegador) ---
# Apenas variáveis com prefixo VITE_ chegam ao navegador. Nunca coloque segredo aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_VAPID_PUBLIC_KEY=

# --- Supabase CLI e migrations (somente local) ---
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# --- Web Push (a chave privada vira secret do Supabase; gerada na configuração) ---
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
